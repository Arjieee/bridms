# Server Port (Render sets this automatically)
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=supersecret_barangay_puerto_jwt_key_2026_relief

# Database Connection URL:
# For SQLite (default, zero configuration):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Render PostgreSQL, Supabase, Neon, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/databasename"

# Optional Email Notification Settings (Brevo / Sendinblue)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@brgy-puerto.gov.ph
BREVO_SENDER_NAME=Barangay Puerto Relief Admin
